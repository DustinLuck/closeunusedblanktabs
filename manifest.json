{
    "manifest_version": 2,
    "name": "closeunusedblanktabs",
    "version": "0.1.0",
    "description": "Closes unused blank tabs",
    "permissions": [
        "tabs",
        "storage"
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    },
    "background": {
        "scripts": ["closeunusedblanktabs.js"]
    },

    "browser_specific_settings": {
        "gecko": {
            "id": "@closeunusedblanktabs",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
