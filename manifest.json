{
    "manifest_version": 2,
    "name": "closeunusedblanktabs",
    "version": "0.0.7",
    "description": "Closes unused blank tabs",
    "permissions": [
        "tabs"
    ],
    "background": {
        "scripts": ["closeunusedblanktabs.js"]
    },

    "browser_specific_settings": {
        "gecko": {
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
